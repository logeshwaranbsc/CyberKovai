<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Deny direct web access to environment, composer, tests, includes, and secure storage
    RewriteRule ^(\.env|\.env\..*|composer\.(json|lock)|phpunit\.xml)$ - [F,L,NC]
    RewriteRule ^(vendor|tests|storage|includes|admin/includes)/ - [F,L,NC]

    # Handle Section Routing
    RewriteRule ^cyber-intelligence/services/?$ cyber-intelligence.php?section=forensics#ci-services [L,QSA]
    RewriteRule ^cyber-intelligence/?$ cyber-intelligence.php?section=forensics [L,QSA]

    RewriteRule ^digital-forensics/services/?$ digital-forensics.php?section=cyber#services [L,QSA]
    RewriteRule ^digital-forensics/?$ digital-forensics.php?section=cyber [L,QSA]
    RewriteRule ^digitalforensics/services/?$ digital-forensics.php?section=cyber#services [L,QSA]
    RewriteRule ^digitalforensics/?$ digital-forensics.php?section=cyber [L,QSA]

    # Route service page requests made under section prefixes to root services directory
    RewriteRule ^digital-forensics/services/(.+)$ services/$1 [L,QSA]
    RewriteRule ^digitalforensics/services/(.+)$ services/$1 [L,QSA]
    RewriteRule ^cyber-intelligence/services/(.+)$ services/$1 [L,QSA]
    RewriteRule ^investigation/services/(.+)$ services/$1 [L,QSA]

    RewriteRule ^about/?$ about.php [L,QSA]
    RewriteRule ^contact/?$ contact.php [L,QSA]
    RewriteRule ^investigation/?$ cyber-intelligence.php?section=forensics [L,QSA]
    RewriteRule ^investigation\.php$ cyber-intelligence.php?section=forensics [L,QSA]

    # Clean URL handling (.php extension hiding)
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}\.php -f
    RewriteRule ^(.*)$ $1.php [L,QSA]
</IfModule>
