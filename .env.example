# Google reCAPTCHA Configuration (false = disabled for testing)
ENABLE_RECAPTCHA=false
RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key_here

# Google Sheets Integration (Apps Script Web App)
GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/AKfycbxCF61hcrOSjTVht96TrymhNCjzLCRPyeRByyD4t1OYRy96c6SMkjqyh-PLnsR_3zztfA/exec
GOOGLE_SHEETS_SECRET=your_google_sheets_secret_here
GOOGLE_SPREADSHEET_ID=1L6CQ3_fQQymHvjt3jhyzvGVU3OK-jlYlxkkca_8gLKw
GOOGLE_SHEET_TAB=Website Leads

# Admin Two-Factor Authentication & Encryption
# Generate a 256-bit key with: php -r "echo 'base64:' . base64_encode(random_bytes(32)) . PHP_EOL;"
CK_APP_KEY=
CK_2FA_ISSUER="Cyber Kovai"
CK_2FA_WINDOW=1
CK_2FA_CHALLENGE_TTL=300
# Optional: absolute directory outside the web root for sensitive 2FA records, rate limits, backups, and audit logs
CK_SECURE_STORAGE_DIR=
# Set true in HTTPS production to enforce Secure cookie flag (also auto-detected on HTTPS requests)
SESSION_SECURE_COOKIE=false
